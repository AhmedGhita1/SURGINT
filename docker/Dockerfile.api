FROM python:3.12.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SURGINT_CHECKPOINT=/app/model \
    SURGINT_DEVICE=cpu \
    SURGINT_MAX_SESSIONS=8

# the largest wheel by far, installed before any source is copied so editing
# the source does not download it again
RUN python -m pip install torch==2.4.1 \
        --index-url https://download.pytorch.org/whl/cpu \
    && useradd --create-home --uid 10001 surgint

# the source is built from /src and discarded, so /app holds no copy of the
# package to shadow the installed one on sys.path.
#
# the default 15 second socket timeout gives up on a slow mirror partway
# through a large sdist, and a half-read body then fails its hash check
COPY pyproject.toml README.md /src/
COPY surgint/ /src/surgint/
COPY services/ /src/services/
RUN python -m pip install --retries 10 --timeout 120 "/src[serving]" \
    && rm -rf /src

WORKDIR /app

ARG MODEL_PATH=models/fair-raven
COPY --chown=surgint:surgint ${MODEL_PATH}/ /app/model/

USER surgint

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=120s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]

CMD ["python", "-m", "uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

<?xml version="1.0" encoding="UTF-8"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
    xml:base="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT"
    ontologyIRI="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT"
    versionIRI="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT/1.0.0">

    <Prefix name="" IRI="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>

    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="en">SURGINT</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">An OWL 2 ontology for detector-aligned surgical instrument handling and inventory knowledge.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>1.0.0</Literal>
    </Annotation>

    <!-- Object properties -->
    <Declaration><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/></Declaration>
    <Declaration><ObjectProperty abbreviatedIRI=":hasHazardClass"/></Declaration>
    <Declaration><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/></Declaration>

    <FunctionalObjectProperty>
        <ObjectProperty abbreviatedIRI=":hasDisposalStatus"/>
    </FunctionalObjectProperty>
    <FunctionalObjectProperty>
        <ObjectProperty abbreviatedIRI=":hasHazardClass"/>
    </FunctionalObjectProperty>

    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#hasDisposalStatus</IRI>
        <Literal xml:lang="en">has disposal status</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasDisposalStatus</IRI>
        <Literal xml:lang="en">Relates an item to its reusable or single-use lifecycle designation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#hasHazardClass</IRI>
        <Literal xml:lang="en">has hazard class</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasHazardClass</IRI>
        <Literal xml:lang="en">Relates an item to its sharp-hazard classification; none means that no intrinsic sharp hazard is asserted.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#hasFunctionalRole</IRI>
        <Literal xml:lang="en">has functional role</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#hasFunctionalRole</IRI>
        <Literal xml:lang="en">Relates an item to a handling-relevant functional role used for inventory grouping and tray organization.</Literal>
    </AnnotationAssertion>

    <!-- Controlled values: disposal status -->
    <Declaration><NamedIndividual abbreviatedIRI=":reusable"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":single-use"/></Declaration>

    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#reusable</IRI>
        <Literal xml:lang="en">reusable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#reusable</IRI>
        <Literal xml:lang="en">A disposal-status value for an item intended to enter a validated reprocessing cycle before reuse.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#single-use</IRI>
        <Literal xml:lang="en">single-use</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#single-use</IRI>
        <Literal xml:lang="en">A disposal-status value for an item intended for one use and subsequent disposal under applicable policy.</Literal>
    </AnnotationAssertion>

    <!-- Controlled values: hazard class -->
    <Declaration><NamedIndividual abbreviatedIRI=":sharp"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":none"/></Declaration>

    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#sharp</IRI>
        <Literal xml:lang="en">sharp</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#sharp</IRI>
        <Literal xml:lang="en">A hazard value for an item with an intrinsic cutting or puncturing edge or point.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#none</IRI>
        <Literal xml:lang="en">none</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#none</IRI>
        <Literal xml:lang="en">A hazard value stating that the detector category has no intrinsic sharp hazard; it does not mean risk-free or uncontaminated.</Literal>
    </AnnotationAssertion>

    <!-- Controlled values: functional role -->
    <Declaration><NamedIndividual abbreviatedIRI=":cutting"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":grasping"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":clamping"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":tissue-retraction"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":tissue-dissection"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":fluid-delivery"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":instrument-support"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":fluid-containment"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":absorption"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":wound-dressing"/></Declaration>
    <Declaration><NamedIndividual abbreviatedIRI=":fluid-conveyance"/></Declaration>

    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#cutting</IRI><Literal xml:lang="en">cutting</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#cutting</IRI><Literal xml:lang="en">The functional role of dividing tissue or material with a cutting edge.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#grasping</IRI><Literal xml:lang="en">grasping</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#grasping</IRI><Literal xml:lang="en">The functional role of holding or manipulating tissue or material.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#clamping</IRI><Literal xml:lang="en">clamping</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#clamping</IRI><Literal xml:lang="en">The functional role of occluding or securely holding tissue or a vessel.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#tissue-retraction</IRI><Literal xml:lang="en">tissue retraction</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#tissue-retraction</IRI><Literal xml:lang="en">The functional role of holding tissue aside to expose an operative field.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#tissue-dissection</IRI><Literal xml:lang="en">tissue dissection</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#tissue-dissection</IRI><Literal xml:lang="en">The functional role of separating tissue planes.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#fluid-delivery</IRI><Literal xml:lang="en">fluid delivery</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#fluid-delivery</IRI><Literal xml:lang="en">The functional role of injecting or dispensing fluid.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#instrument-support</IRI><Literal xml:lang="en">instrument support</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#instrument-support</IRI><Literal xml:lang="en">The functional role of holding and organizing instruments or supplies.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#fluid-containment</IRI><Literal xml:lang="en">fluid containment</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#fluid-containment</IRI><Literal xml:lang="en">The functional role of receiving or holding fluid.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#absorption</IRI><Literal xml:lang="en">absorption</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#absorption</IRI><Literal xml:lang="en">The functional role of absorbing blood or other fluid.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#wound-dressing</IRI><Literal xml:lang="en">wound dressing</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#wound-dressing</IRI><Literal xml:lang="en">The functional role of covering, securing, or supporting a wound dressing.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#fluid-conveyance</IRI><Literal xml:lang="en">fluid conveyance</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#fluid-conveyance</IRI><Literal xml:lang="en">The functional role of carrying fluid or gas between locations.</Literal></AnnotationAssertion>

    <!-- The values are explicit alternatives; OWL does not assume different IRIs denote different things. -->
    <DifferentIndividuals>
        <NamedIndividual abbreviatedIRI=":reusable"/>
        <NamedIndividual abbreviatedIRI=":single-use"/>
        <NamedIndividual abbreviatedIRI=":sharp"/>
        <NamedIndividual abbreviatedIRI=":none"/>
        <NamedIndividual abbreviatedIRI=":cutting"/>
        <NamedIndividual abbreviatedIRI=":grasping"/>
        <NamedIndividual abbreviatedIRI=":clamping"/>
        <NamedIndividual abbreviatedIRI=":tissue-retraction"/>
        <NamedIndividual abbreviatedIRI=":tissue-dissection"/>
        <NamedIndividual abbreviatedIRI=":fluid-delivery"/>
        <NamedIndividual abbreviatedIRI=":instrument-support"/>
        <NamedIndividual abbreviatedIRI=":fluid-containment"/>
        <NamedIndividual abbreviatedIRI=":absorption"/>
        <NamedIndividual abbreviatedIRI=":wound-dressing"/>
        <NamedIndividual abbreviatedIRI=":fluid-conveyance"/>
    </DifferentIndividuals>

    <!-- Exactly 13 detector classes, all direct subclasses of owl:Thing. -->
    <Declaration><Class abbreviatedIRI=":scalpel"/></Declaration>
    <Declaration><Class abbreviatedIRI=":forceps"/></Declaration>
    <Declaration><Class abbreviatedIRI=":hemostat"/></Declaration>
    <Declaration><Class abbreviatedIRI=":scissors"/></Declaration>
    <Declaration><Class abbreviatedIRI=":retractor"/></Declaration>
    <Declaration><Class abbreviatedIRI=":dissector"/></Declaration>
    <Declaration><Class abbreviatedIRI=":syringe"/></Declaration>
    <Declaration><Class abbreviatedIRI=":tray"/></Declaration>
    <Declaration><Class abbreviatedIRI=":basin"/></Declaration>
    <Declaration><Class abbreviatedIRI=":bowl"/></Declaration>
    <Declaration><Class abbreviatedIRI=":gauze"/></Declaration>
    <Declaration><Class abbreviatedIRI=":bandage"/></Declaration>
    <Declaration><Class abbreviatedIRI=":tube"/></Declaration>

    <SubClassOf><Class abbreviatedIRI=":scalpel"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":forceps"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":hemostat"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":scissors"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":retractor"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":dissector"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":syringe"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":tray"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":basin"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bowl"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":gauze"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bandage"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":tube"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>

    <DisjointClasses>
        <Class abbreviatedIRI=":scalpel"/>
        <Class abbreviatedIRI=":forceps"/>
        <Class abbreviatedIRI=":hemostat"/>
        <Class abbreviatedIRI=":scissors"/>
        <Class abbreviatedIRI=":retractor"/>
        <Class abbreviatedIRI=":dissector"/>
        <Class abbreviatedIRI=":syringe"/>
        <Class abbreviatedIRI=":tray"/>
        <Class abbreviatedIRI=":basin"/>
        <Class abbreviatedIRI=":bowl"/>
        <Class abbreviatedIRI=":gauze"/>
        <Class abbreviatedIRI=":bandage"/>
        <Class abbreviatedIRI=":tube"/>
    </DisjointClasses>

    <!-- Detector labels and class documentation. -->
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#scalpel</IRI><Literal>scalpel</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#scalpel</IRI><Literal xml:lang="en">A bladed surgical cutting instrument used to make incisions.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#forceps</IRI><Literal>forceps</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#forceps</IRI><Literal xml:lang="en">A surgical instrument used to grasp or manipulate tissue or material.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#hemostat</IRI><Literal>hemostat</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#hemostat</IRI><Literal xml:lang="en">A locking clamp used to control bleeding by occluding a vessel or tissue.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#scissors</IRI><Literal>scissors</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#scissors</IRI><Literal xml:lang="en">A paired-blade surgical instrument used to cut tissue or material.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#retractor</IRI><Literal>retractor</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#retractor</IRI><Literal xml:lang="en">A surgical instrument used to hold tissue aside and expose the operative field.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#dissector</IRI><Literal>dissector</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#dissector</IRI><Literal xml:lang="en">A surgical instrument used to separate tissue planes.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#syringe</IRI><Literal>syringe</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#syringe</IRI><Literal xml:lang="en">A plunger-operated device used to inject, withdraw, or dispense fluid.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#tray</IRI><Literal>tray</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#tray</IRI><Literal xml:lang="en">A shallow platform or receptacle used to hold and organize surgical items.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#basin</IRI><Literal>basin</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#basin</IRI><Literal xml:lang="en">A broad surgical receptacle used to receive or hold fluid.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#bowl</IRI><Literal>bowl</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#bowl</IRI><Literal xml:lang="en">A round surgical receptacle used to receive or hold fluid or supplies.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#gauze</IRI><Literal>gauze</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#gauze</IRI><Literal xml:lang="en">An absorbent textile used to absorb fluid, cover tissue, or assist wound care.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#bandage</IRI><Literal>bandage</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#bandage</IRI><Literal xml:lang="en">A material applied to cover, secure, or support a wound dressing.</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#tube</IRI><Literal>tube</Literal></AnnotationAssertion>
    <AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#tube</IRI><Literal xml:lang="en">A flexible hollow conduit used to convey fluid or gas.</Literal></AnnotationAssertion>

    <!-- Class-level knowledge is represented as ObjectHasValue restrictions. -->
    <SubClassOf><Class abbreviatedIRI=":scalpel"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":sharp"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":scalpel"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":cutting"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":forceps"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":grasping"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":hemostat"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":hemostat"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":clamping"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":scissors"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":sharp"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":scissors"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":cutting"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":retractor"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":tissue-retraction"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":dissector"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":tissue-dissection"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":syringe"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":single-use"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":syringe"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":fluid-delivery"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":tray"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":reusable"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":tray"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":tray"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":instrument-support"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":basin"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":reusable"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":basin"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":basin"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":fluid-containment"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":bowl"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":reusable"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bowl"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bowl"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":fluid-containment"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":gauze"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":single-use"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":gauze"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":gauze"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":absorption"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":bandage"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasDisposalStatus"/><NamedIndividual abbreviatedIRI=":single-use"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bandage"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":bandage"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":wound-dressing"/></ObjectHasValue></SubClassOf>

    <SubClassOf><Class abbreviatedIRI=":tube"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasHazardClass"/><NamedIndividual abbreviatedIRI=":none"/></ObjectHasValue></SubClassOf>
    <SubClassOf><Class abbreviatedIRI=":tube"/><ObjectHasValue><ObjectProperty abbreviatedIRI=":hasFunctionalRole"/><NamedIndividual abbreviatedIRI=":fluid-conveyance"/></ObjectHasValue></SubClassOf>

</Ontology>

<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT#"
    xml:base="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/ahmedghita/ontologies/2026/SURGINT/1.0.0"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <rdfs:label xml:lang="en">SURGINT</rdfs:label>
        <rdfs:comment xml:lang="en">Detector-aligned knowledge for surgical tray inventory and handling.</rdfs:comment>
    </owl:Ontology>

    <owl:ObjectProperty rdf:about="#hasDisposalStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has disposal status</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasHazardClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has hazard class</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasFunctionalRole">
        <rdfs:label xml:lang="en">has functional role</rdfs:label>
    </owl:ObjectProperty>

    <owl:NamedIndividual rdf:about="#reusable">
        <rdfs:label xml:lang="en">reusable</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#single-use">
        <rdfs:label xml:lang="en">single-use</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#sharp">
        <rdfs:label xml:lang="en">sharp</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#none">
        <rdfs:label xml:lang="en">none</rdfs:label>
        <rdfs:comment xml:lang="en">No intrinsic sharp hazard is asserted; this does not mean risk-free or uncontaminated.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#cutting">
        <rdfs:label xml:lang="en">cutting</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#grasping">
        <rdfs:label xml:lang="en">grasping</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#clamping">
        <rdfs:label xml:lang="en">clamping</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#tissue-retraction">
        <rdfs:label xml:lang="en">tissue retraction</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#tissue-dissection">
        <rdfs:label xml:lang="en">tissue dissection</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#fluid-delivery">
        <rdfs:label xml:lang="en">fluid delivery</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#instrument-support">
        <rdfs:label xml:lang="en">instrument support</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#fluid-containment">
        <rdfs:label xml:lang="en">fluid containment</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#absorption">
        <rdfs:label xml:lang="en">absorption</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#wound-dressing">
        <rdfs:label xml:lang="en">wound dressing</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#fluid-conveyance">
        <rdfs:label xml:lang="en">fluid conveyance</rdfs:label>
    </owl:NamedIndividual>

    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="#reusable"/>
            <rdf:Description rdf:about="#single-use"/>
            <rdf:Description rdf:about="#sharp"/>
            <rdf:Description rdf:about="#none"/>
            <rdf:Description rdf:about="#cutting"/>
            <rdf:Description rdf:about="#grasping"/>
            <rdf:Description rdf:about="#clamping"/>
            <rdf:Description rdf:about="#tissue-retraction"/>
            <rdf:Description rdf:about="#tissue-dissection"/>
            <rdf:Description rdf:about="#fluid-delivery"/>
            <rdf:Description rdf:about="#instrument-support"/>
            <rdf:Description rdf:about="#fluid-containment"/>
            <rdf:Description rdf:about="#absorption"/>
            <rdf:Description rdf:about="#wound-dressing"/>
            <rdf:Description rdf:about="#fluid-conveyance"/>
        </owl:distinctMembers>
    </owl:AllDifferent>

    <owl:Class rdf:about="#scalpel">
        <rdfs:label>scalpel</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#sharp"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#cutting"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#forceps">
        <rdfs:label>forceps</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#grasping"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#hemostat">
        <rdfs:label>hemostat</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#clamping"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#scissors">
        <rdfs:label>scissors</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#sharp"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#cutting"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#retractor">
        <rdfs:label>retractor</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#tissue-retraction"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#dissector">
        <rdfs:label>dissector</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#tissue-dissection"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#syringe">
        <rdfs:label>syringe</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#single-use"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#fluid-delivery"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#tray">
        <rdfs:label>tray</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#reusable"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#instrument-support"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#basin">
        <rdfs:label>basin</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#reusable"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#fluid-containment"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#bowl">
        <rdfs:label>bowl</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#reusable"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#fluid-containment"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#gauze">
        <rdfs:label>gauze</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#single-use"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#absorption"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#bandage">
        <rdfs:label>bandage</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasDisposalStatus"/><owl:hasValue rdf:resource="#single-use"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#wound-dressing"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="#tube">
        <rdfs:label>tube</rdfs:label>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasHazardClass"/><owl:hasValue rdf:resource="#none"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasFunctionalRole"/><owl:hasValue rdf:resource="#fluid-conveyance"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#scalpel"/>
            <rdf:Description rdf:about="#forceps"/>
            <rdf:Description rdf:about="#hemostat"/>
            <rdf:Description rdf:about="#scissors"/>
            <rdf:Description rdf:about="#retractor"/>
            <rdf:Description rdf:about="#dissector"/>
            <rdf:Description rdf:about="#syringe"/>
            <rdf:Description rdf:about="#tray"/>
            <rdf:Description rdf:about="#basin"/>
            <rdf:Description rdf:about="#bowl"/>
            <rdf:Description rdf:about="#gauze"/>
            <rdf:Description rdf:about="#bandage"/>
            <rdf:Description rdf:about="#tube"/>
        </owl:members>
    </owl:AllDisjointClasses>
</rdf:RDF>
